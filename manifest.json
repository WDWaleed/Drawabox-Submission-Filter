{
  "manifest_version": 3,
  "name": "Drawabox Submission Filter",
  "version": "1.2.0",
  "description": "Filters Drawing Prompt submissions from Drawabox sketchbook pages.",
  "host_permissions": ["https://drawabox.com/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "drawabox-submission-filter@example.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://drawabox.com/community/sketchbook/*/submissions*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
